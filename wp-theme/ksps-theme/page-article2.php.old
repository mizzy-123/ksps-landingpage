get_header();

?>
<style>
  /* Article Carousel Animations */
  @keyframes slideOutLeft {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-50px); }
  }
  @keyframes slideOutRight {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(50px); }
  }
  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-50px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(50px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .slide-out-left { animation: slideOutLeft 0.5s ease-in-out forwards; }
  .slide-out-right { animation: slideOutRight 0.5s ease-in-out forwards; }
  .slide-in-left { animation: slideInLeft 0.5s ease-in-out forwards; }
  .slide-in-right { animation: slideInRight 0.5s ease-in-out forwards; }
</style>

<?php
// 1. Prepare Data for Carousel (Latest 5 posts)
$carousel_args = [
    'post_type'      => 'post',
    'posts_per_page' => 5,
    'post_status'    => 'publish',
    'orderby'        => 'date',
    'order'          => 'DESC',
];
$carousel_query = new WP_Query($carousel_args);
$carousel_data = [];

if ($carousel_query->have_posts()) :
    while ($carousel_query->have_posts()) : $carousel_query->the_post();
        $author_id = get_the_author_meta('ID');
        $carousel_data[] = [
            'id'          => get_the_ID(),
            'authorImage' => get_avatar_url($author_id, ['size' => 96]),
            'authorName'  => get_the_author(),
            'date'        => get_the_date('j F Y'), // e.g. 30 Januari 2026
            'title'       => get_the_title(),
            'description' => get_the_excerpt(),
            'thumbnail'   => get_the_post_thumbnail_url(get_the_ID(), 'full') ?: '',
            'link'        => get_permalink(),
        ];
    endwhile;
    wp_reset_postdata();
endif;

// First item for initial render
$first_article = !empty($carousel_data) ? $carousel_data[0] : null; // Fallback handled by JS if empty array, but PHP rendering needs safe check
?>

<!-- Inject Carousel Data -->
<script>
    window.kspsArticleData = <?php echo json_encode($carousel_data); ?>;
</script>

