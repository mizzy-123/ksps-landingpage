    <!-- Category Sections -->
    <?php
    $categories = get_categories([
        'hide_empty' => true,
        'exclude' => [1], // Optional: Exclude 'Uncategorized' if id is 1
    ]);

    // Custom Sort: Move 'outsourcing-bpo' to the top
    usort($categories, function($a, $b) {
        if ($a->slug === 'outsourcing-bpo') return -1;
        if ($b->slug === 'outsourcing-bpo') return 1;
        return 0; // Maintain existing order for others
    });
    
    foreach ($categories as $cat) :
        // Special condition for "Outsourcing & BPO" (slug: outsourcing-bpo)
        $is_outsourcing = ($cat->slug === 'outsourcing-bpo');
        
        $cat_query = new WP_Query([
            'cat' => $cat->term_id,
            'posts_per_page' => 5,
        ]);
        
        if ($cat_query->have_posts()) :
            $bg_class = $is_outsourcing ? 'bg-primary' : '';
            $text_title_class = $is_outsourcing ? 'text-background' : 'text-primary';
            $text_link_class = $is_outsourcing ? 'text-background' : 'text-primary';
    ?>
    <section class="w-full h-fit lg:px-14 px-4 lg:py-16 py-8 <?php echo $bg_class; ?>">
        <div class="w-full flex flex-wrap justify-between items-center">
            <!-- Category Name -->
            <h1 class="font-marope lg:text-[28px] text-[20px] font-bold <?php echo $text_title_class; ?>">
                <?php echo esc_html($cat->name); ?>
            </h1>

            <a href="<?php echo get_category_link($cat->term_id); ?>" class="font-inter lg:text-[16px] text-sm font-bold text-background <?php echo $text_link_class; ?>">
                Lihat Semua Artikel →
            </a>
        </div>

        <!-- Isi article ini maksimal 5 -->
        <div class="mt-8 flex lg:flex-row flex-col gap-6 overflow-x-auto pb-4">
            <?php
            while ($cat_query->have_posts()) : $cat_query->the_post();
                $thumb_url = get_the_post_thumbnail_url(get_the_ID(), 'full');
                $author_id = get_the_author_meta('ID');
                $author_img = get_avatar_url($author_id, ['size' => 64]);
