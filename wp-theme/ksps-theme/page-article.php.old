<?php
/**
 * Template Name: Article Page
 * Description: Dynamic article page with carousel, search, and categories
 */

if (!defined('ABSPATH')) {
  exit;
}

get_header();

// Get search query
$search_query = isset($_GET['search']) ? sanitize_text_field($_GET['search']) : '';

// Query untuk hero carousel (ambil 1 artikel terbaru untuk hero)
$hero_args = array(
  'post_type'      => 'post',
  'posts_per_page' => 1,
  'post_status'    => 'publish',
  'orderby'        => 'date',
  'order'          => 'DESC'
);
$hero_query = new WP_Query($hero_args);

// Query untuk artikel lainnya (exclude yang di hero)
$exclude_ids = array();
if ($hero_query->have_posts()) {
  $exclude_ids = wp_list_pluck($hero_query->posts, 'ID');
}

$main_args = array(
  'post_type'      => 'post',
  'posts_per_page' => 4,
  's'              => $search_query,
  'post_status'    => 'publish',
  'post__not_in'   => $exclude_ids
);
$main_query = new WP_Query($main_args);
?>

<!-- CSS Animations for Article Carousel -->
<style>
  @keyframes slideOutLeft {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-50px);
    }
  }

  @keyframes slideOutRight {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(50px);
    }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .slide-out-left {
    animation: slideOutLeft 0.5s ease-in-out forwards;
  }

  .slide-out-right {
    animation: slideOutRight 0.5s ease-in-out forwards;
  }

  .slide-in-left {
    animation: slideInLeft 0.5s ease-in-out forwards;
  }

  .slide-in-right {
    animation: slideInRight 0.5s ease-in-out forwards;
  }
</style>

<main class="bg-background">
  <!-- Hero Carousel Section -->
  <?php if ($show_hero && $hero_query->have_posts()) : ?>
    <div style="position: relative; margin-bottom: 120px;">

      <div id="hero-slider" style="overflow: hidden; border-radius: 20px; background: #fff;">
